# =============================================================================
# CIPOLATTI - Variáveis de ambiente do Backend (produção)
# =============================================================================
# Copie este arquivo para /opt/cipolatti/backend/.env e ajuste os valores
# NUNCA cometa este arquivo com valores reais para o repositório.
# =============================================================================

# MongoDB local na VM (instalado via apt). Troque se usar Atlas/replica set.
MONGO_URL="mongodb://127.0.0.1:27017"
DB_NAME="cipolatti"

# Origins permitidos no CORS. Separe por vírgula, sem espaços.
# Exemplo: "https://portaria.suaempresa.com.br"
CORS_ORIGINS="https://portaria.suaempresa.com.br"
FRONTEND_URL="https://portaria.suaempresa.com.br"

# JWT - GERE UM SEGREDO FORTE! Ex: openssl rand -hex 64
JWT_SECRET="TROQUE_ESTE_SEGREDO_POR_ALGO_DE_128_CARACTERES_ALEATORIOS"

# Chave do Emergent Object Storage (necessária apenas se for usar upload
# de fotos de frota/carregamentos). Se não usar, deixe em branco.
EMERGENT_LLM_KEY=""

# Admin inicial (criado automaticamente no primeiro boot).
# Troque ANTES do primeiro deploy e depois apague a variável.
ADMIN_EMAIL="admin@suaempresa.com.br"
ADMIN_PASSWORD="SenhaForteParaOAdmin!"
