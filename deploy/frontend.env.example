# =============================================================================
# CIPOLATTI - Variáveis de ambiente do Frontend (build de produção)
# =============================================================================
# Copie para /opt/cipolatti/frontend/.env ANTES de rodar `yarn build`.
# O React Scripts consome estas variáveis no momento do build.
# =============================================================================

# URL pública do backend (o Nginx faz o proxy para 127.0.0.1:8001).
# Em produção o frontend e o backend vivem no mesmo domínio, então o
# REACT_APP_BACKEND_URL deve ser a URL pública do site.
REACT_APP_BACKEND_URL=https://portaria.suaempresa.com.br

# Sempre false em produção - específico do ambiente Emergent.
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
